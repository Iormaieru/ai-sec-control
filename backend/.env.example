# Local (docker compose):
AISEC_DATABASE_URL=postgresql+psycopg://aisec:aisec@localhost:5433/aisec
# Cloud SQL desde Cloud Run (socket unix; la contraseña va URL-encoded):
# AISEC_DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@/aisec?host=/cloudsql/PROYECTO:REGION:INSTANCIA
AISEC_JWT_SECRET=dev-secret-change-me
AISEC_ENVIRONMENT=development

# Incremento 2 — capa LLM
AISEC_LLM_PROVIDER=openai
AISEC_OPENAI_API_KEY=

# Fuera de development, JWT_SECRET debe ser propio y de >= 32 caracteres.
# AISEC_ENVIRONMENT=production
# Pool por instancia (pool_size * instancias máximas < max_connections de Cloud SQL)
# AISEC_DB_POOL_SIZE=5
# AISEC_DB_MAX_OVERFLOW=2
# AISEC_CORS_ALLOWED_ORIGINS=https://tu-frontend.example.com
# Tests: siempre contra una base local (por defecto localhost:5433/aisec_test)
# AISEC_TEST_DATABASE_URL=postgresql+psycopg://aisec:aisec@localhost:5433/aisec_test

# Logging (stdout -> Cloud Logging -> Dynatrace). Fuera de development el
# formato por defecto es JSON; en development, texto legible.
# AISEC_LOG_LEVEL=INFO
# AISEC_LOG_FORMAT=json
# AISEC_GCP_PROJECT_ID=mi-proyecto   # agrega logging.googleapis.com/trace

# Cuestionario por email. "console" no envía: la API devuelve el enlace para
# copiarlo a mano. En producción: smtp + la URL pública del frontend.
# AISEC_EMAIL_BACKEND=smtp
# AISEC_EMAIL_FROM=ai-sec-control@tu-dominio.com
# AISEC_SMTP_HOST=smtp-relay.tu-dominio.com
# AISEC_SMTP_PORT=587
# AISEC_SMTP_USER=
# AISEC_SMTP_PASSWORD=
# AISEC_SMTP_STARTTLS=true
# AISEC_FRONTEND_BASE_URL=https://tu-frontend.example.com
# AISEC_CUESTIONARIO_VALIDEZ_DIAS=15

# Integración con Jira Cloud (app/integraciones/jira + worker/). Apagada por
# default. Con true, el worker crea los casos nuevos como tickets y trae los
# del tablero IA-SEC; el backend hace las acciones en vivo (transiciones,
# asignación). Token: https://id.atlassian.com/manage-profile/security/api-tokens
# AISEC_JIRA_ENABLED=true
# AISEC_JIRA_BASE_URL=https://bancomacro.atlassian.net
# AISEC_JIRA_EMAIL=cuenta-servicio@macro.com.ar
# AISEC_JIRA_API_TOKEN=
# AISEC_JIRA_PROJECT_KEY=MDA
# AISEC_JIRA_ISSUE_TYPE_ID=11144
# AISEC_JIRA_BOARD_ID=12753
# Worker: cada cuántos segundos trae los cambios de Jira (mínimo 30).
# AISEC_JIRA_SYNC_INTERVALO_SEGUNDOS=120
# Header X-Aisec-Secret del webhook de Jira Automation (opcional, requiere admin de Jira).
# AISEC_JIRA_WEBHOOK_SECRET=

# Herramientas de pentesting (worker): revisión del Catálogo y Radar cada 15 días.
# Token fine-grained de GitHub de SÓLO LECTURA de repos públicos (sin permisos extra).
# AISEC_GITHUB_TOKEN=
# AISEC_HERRAMIENTAS_REVISION_DIAS=15
