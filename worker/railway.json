  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "worker/Dockerfile",
    "watchPatterns": ["worker/**", "backend/app/**", "backend/pyproject.toml", "backend/uv.lock"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
